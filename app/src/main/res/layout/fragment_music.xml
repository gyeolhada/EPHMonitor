<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_dynamic"
    tools:context=".ui.music.MusicFragment">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/leftarrow"
        android:layout_marginTop="25dp"
        android:layout_marginLeft="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <!-- 音乐标题 -->
    <TextView
        android:id="@+id/tv_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_orange_square"
        android:drawablePadding="5dp"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        android:text="音乐播放"
        android:textColor="@color/wd_main"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />>

    <!-- 显示歌曲标题 -->
<TextView
android:id="@+id/songTitle"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:text="Song Title"
android:textSize="20sp"
android:textColor="@color/wd_main"
android:textStyle="bold"
app:layout_constraintTop_toBottomOf="@id/tv_music"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent"
android:paddingTop="10dp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/albumArt"
        android:layout_width="230dp"
        android:layout_height="230dp"
        android:src="@drawable/ic_album_art"
        android:scaleType="centerCrop"
        android:elevation="10dp"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@id/songTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="20dp"
        app:shapeAppearanceOverlay="@style/CircleShape"/>

    <!-- 播放进度条 -->
<SeekBar
android:id="@+id/songProgress"
android:layout_width="0dp"
android:layout_height="wrap_content"
android:max="100"
android:progressTint="@color/wd_main"
android:thumbTint="@color/wd_main"
android:layout_marginTop="20dp"
app:layout_constraintTop_toBottomOf="@id/albumArt"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent" />

    <!-- 显示歌曲时长 -->
    <TextView
        android:id="@+id/songDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/songProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 播放/暂停按钮 -->
    <ImageView
        android:id="@+id/playPause_iv"
        android:layout_marginTop="20dp"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/ic_play"
        app:layout_goneMarginTop="20dp"
        android:contentDescription="Play/Pause"
        app:layout_constraintTop_toBottomOf="@id/songDuration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 上一首按钮 -->
    <ImageView
        android:id="@+id/prev_iv"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_previous"
        android:layout_marginRight="40dp"
        android:contentDescription="Previous"
        app:layout_constraintTop_toTopOf="@+id/playPause_iv"
        app:layout_constraintBottom_toBottomOf="@+id/playPause_iv"
        app:layout_constraintEnd_toStartOf="@+id/playPause_iv"
        />

    <!-- 下一首按钮 -->
    <ImageView
        android:id="@+id/next_iv"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_next"
        android:layout_marginLeft="40dp"
        android:contentDescription="Next"
        app:layout_constraintTop_toTopOf="@+id/playPause_iv"
        app:layout_constraintBottom_toBottomOf="@+id/playPause_iv"
        app:layout_constraintStart_toEndOf="@+id/playPause_iv" />

    <ImageView
        android:id="@+id/repeat_iv"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_repeat"
        android:contentDescription="Repeat"
        android:layout_marginRight="40dp"
        app:layout_constraintTop_toTopOf="@+id/prev_iv"
        app:layout_constraintBottom_toBottomOf="@+id/prev_iv"
        app:layout_constraintEnd_toStartOf="@+id/prev_iv"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/shuffle_iv"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_shuffle"
        android:layout_marginRight="40dp"
        android:contentDescription="Shuffle"
        app:layout_constraintTop_toTopOf="@+id/prev_iv"
        app:layout_constraintBottom_toBottomOf="@+id/prev_iv"
        app:layout_constraintEnd_toStartOf="@+id/prev_iv"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/list_iv"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_list"
        android:layout_marginRight="40dp"
        android:contentDescription="List"
        app:layout_constraintTop_toTopOf="@+id/prev_iv"
        app:layout_constraintBottom_toBottomOf="@+id/prev_iv"
        app:layout_constraintEnd_toStartOf="@+id/prev_iv"
        android:visibility="visible" />


    <!-- 歌单展开/收起按钮 -->
    <ImageView
        android:id="@+id/togglePlaylist_iv"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/ic_playlist"
        android:contentDescription="Toggle Playlist"
        android:layout_marginLeft="40dp"
        app:layout_constraintTop_toTopOf="@+id/next_iv"
        app:layout_constraintBottom_toBottomOf="@+id/next_iv"
        app:layout_constraintStart_toEndOf="@+id/next_iv"
        />

    <!-- 歌单列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/playlistRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/recycler_view_background"
        app:layout_constraintTop_toBottomOf="@+id/togglePlaylist_iv"
        app:layout_constraintStart_toStartOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
